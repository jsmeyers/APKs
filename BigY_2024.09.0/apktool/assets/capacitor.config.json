{
	"appId": "sysnify.com.bigyrelationshop",
	"appName": "Big Y",
	"webDir": "www",
	"server": {
		"androidScheme": "https",
		"iosScheme": "https",
		"hostname": "sysnify.com.bigyrelationshop",
		"allowNavigation": [
			"*",
			"*://sysnify.com.bigyrelationshop/*",
			"*://uat-fulfillment.mercatus.com/*",
			"*://stg-fulfillment.mercatus.com/*"
		]
	},
	"ios": {},
	"android": {},
	"cordova": {
		"preferences": {
			"Scheme": "https",
			"Hostname": "sysnify.com.bigyrelationshop",
			"ScrollEnabled": "false",
			"android-minSdkVersion": "19",
			"BackupWebStorage": "none",
			"orientation": "portrait",
			"WKWebViewOnly": "true",
			"HideKeyboardFormAccessoryBar": "false"
		}
	},
	"plugins": {
		"FirebaseMessaging": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		},
		"SplashScreen": {
			"launchShowDuration": 2500,
			"launchAutoHide": true,
			"launchFadeOutDuration": 500,
			"androidScaleType": "CENTER_CROP",
			"androidSplashResourceName": "splash",
			"splashFullScreen": false,
			"splashImmersive": false
		}
	}
}
