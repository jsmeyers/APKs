<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppBaseTheme" parent="@style/Theme.AppCompat.Light.NoActionBar">
        <item name="android:screenOrientation">portrait</item>
        <item name="android:windowBackground">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowTitleSize">@dimen/title_textview_head</item>
        <item name="android:listDivider">@drawable/shape_pin_checked</item>
        <item name="android:windowSoftInputMode">adjustPan</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:supportsRtl">false</item>
        <item name="colorAccent">@color/theme_color</item>
        <item name="colorPrimary">@color/theme_color</item>
        <item name="colorPrimaryDark">@color/theme_color</item>
    </style>
</resources>
