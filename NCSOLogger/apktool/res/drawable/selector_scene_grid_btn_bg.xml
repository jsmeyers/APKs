            <solid android:color="?custom_attr_app_scene_grid_select_bg_color" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_5" />
            <stroke android:width="1.0dip" android:color="?custom_attr_app_scene_button_selected_stroke_color" />
            <solid android:color="?custom_attr_app_scene_grid_select_bg_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dp_5" />
