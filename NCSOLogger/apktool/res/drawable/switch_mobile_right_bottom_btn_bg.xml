<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="@dimen/switch_btn_radiu" />
            <solid android:color="?custom_attr_app_switch_seton_btn_selected_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_seton_btn_selected_stroke_color" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="@dimen/switch_btn_radiu" />
            <solid android:color="?custom_attr_app_switch_seton_btn_hightlight_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_seton_btn_selected_stroke_color" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="@dimen/switch_btn_radiu" />
            <solid android:color="?custom_attr_app_switch_seton_btn_hightlight_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_seton_btn_selected_stroke_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:bottomRightRadius="@dimen/switch_btn_radiu" />
            <solid android:color="?custom_attr_app_switch_seton_btn_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_seton_btn_stroke_color" />
        </shape>
    </item>
</selector>