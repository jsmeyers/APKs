<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="?custom_attr_app_switch_comment_btn_selected_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_comment_btn_stroke_color" />
            <corners android:bottomLeftRadius="@dimen/dp_15" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="?custom_attr_app_switch_comment_btn_hightlight_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_comment_btn_stroke_color" />
            <corners android:bottomLeftRadius="@dimen/dp_15" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="?custom_attr_app_switch_comment_btn_bg_color" />
            <stroke android:width="@dimen/dp_1" android:color="?custom_attr_app_switch_comment_btn_stroke_color" />
            <corners android:bottomLeftRadius="@dimen/dp_15" />
        </shape>
    </item>
</selector>